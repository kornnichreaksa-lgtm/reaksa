<!DOCTYPE html>
<html lang="km">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>បងស្រឡាញ់អូនខ្លាំងណាស់ 💖 - Ultimate 3D Proposal</title>
  
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Battambang:wght@400;700&family=Moul&family=Pacifico&family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Libraries -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      font-family: 'Battambang', 'Poppins', sans-serif;
    }

    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #09010f;
      color: #fff;
    }

    /* WebGL Background Canvas */
    #canvas-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* UI Overlay Layer */
    .ui-layer {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      padding: 20px 15px;
      pointer-events: none;
    }

    /* Header Bar Buttons */
    .top-controls {
      pointer-events: auto;
      width: 100%;
      max-width: 1100px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px;
    }

    .badge-tag {
      background: rgba(255, 105, 180, 0.15);
      border: 1px solid rgba(255, 182, 193, 0.4);
      padding: 8px 18px;
      border-radius: 50px;
      backdrop-filter: blur(10px);
      font-size: 0.85rem;
      color: #ffb6c1;
      box-shadow: 0 0 15px rgba(255, 105, 180, 0.2);
    }

    .icon-btn {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 182, 193, 0.3);
      color: #ff69b4;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      backdrop-filter: blur(12px);
      transition: all 0.3s ease;
      font-size: 1.1rem;
    }

    .icon-btn:hover {
      background: rgba(255, 105, 180, 0.3);
      color: #fff;
      transform: scale(1.1);
      box-shadow: 0 0 20px rgba(255, 105, 180, 0.6);
    }

    /* Glassmorphism Main Love Letter Card */
    .love-card {
      pointer-events: auto;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1.5px solid rgba(255, 192, 203, 0.3);
      border-radius: 32px;
      padding: 28px 32px;
      max-width: 580px;
      width: 94%;
      text-align: center;
      box-shadow: 0 20px 50px rgba(236, 72, 153, 0.25), inset 0 0 20px rgba(255, 255, 255, 0.08);
      margin-top: 10px;
      animation: floatCard 4s ease-in-out infinite alternate, fadeIn 1s ease-out;
      position: relative;
    }

    .love-card::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: 32px;
      background: linear-gradient(135deg, rgba(255,105,180,0.4), transparent, rgba(236,72,153,0.4));
      z-index: -1;
      pointer-events: none;
    }

    .khmer-title {
      font-family: 'Moul', cursive;
      color: #ff4d94;
      font-size: 1.85rem;
      text-shadow: 0 0 22px rgba(255, 77, 148, 0.8);
      margin-bottom: 12px;
      line-height: 1.5;
    }

    .english-title {
      font-family: 'Pacifico', cursive;
      color: #ffb6c1;
      font-size: 1.1rem;
      margin-bottom: 15px;
      opacity: 0.9;
    }

    .love-text {
      font-size: 1.05rem;
      line-height: 1.85;
      color: #fff0f5;
      margin-bottom: 16px;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
    }

    .highlight-quote {
      background: rgba(255, 20, 147, 0.12);
      border-left: 4px solid #ff1493;
      border-radius: 0 16px 16px 0;
      padding: 10px 16px;
      margin: 15px 0;
      font-style: italic;
      color: #ffb6c1;
      text-align: left;
      font-size: 0.98rem;
    }

    .question-prompt {
      font-size: 1.18rem;
      font-weight: 700;
      color: #ff69b4;
      margin-top: 10px;
      text-shadow: 0 0 10px rgba(255, 105, 180, 0.5);
    }

    /* Buttons Container & Mechanics */
    .buttons-wrapper {
      pointer-events: auto;
      margin-bottom: 30px;
      display: flex;
      gap: 25px;
      justify-content: center;
      align-items: center;
      position: relative;
      min-height: 75px;
      width: 100%;
      max-width: 480px;
    }

    .btn {
      padding: 16px 38px;
      font-size: 1.25rem;
      font-weight: 700;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.25s ease, background 0.3s;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
      display: inline-flex;
      align-items: center;
      gap: 10px;
      outline: none;
    }

    .btn-yes {
      background: linear-gradient(135deg, #ff1493 0%, #ff69b4 50%, #e60073 100%);
      background-size: 200% auto;
      color: #ffffff;
      animation: pulseGlow 2s infinite;
      z-index: 10;
    }

    .btn-yes:hover {
      transform: scale(1.12) translateY(-3px);
      box-shadow: 0 0 35px rgba(255, 20, 147, 0.9);
    }

    .btn-no {
      background: rgba(255, 255, 255, 0.12);
      color: #f3f3f3;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      position: absolute;
      transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      z-index: 10;
    }

    /* Floating Toast Quote Popup */
    .quote-toast {
      position: fixed;
      bottom: 25px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: rgba(20, 5, 20, 0.9);
      border: 1.5px solid #ff69b4;
      border-radius: 50px;
      padding: 12px 28px;
      color: #ffb6c1;
      font-size: 0.95rem;
      z-index: 20;
      box-shadow: 0 10px 30px rgba(255, 105, 180, 0.5);
      pointer-events: none;
      opacity: 0;
      transition: all 0.5s ease;
      white-space: nowrap;
    }

    .quote-toast.active {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    /* Modal Styling */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(8, 1, 12, 0.88);
      backdrop-filter: blur(16px);
      z-index: 100;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.6s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-card {
      background: linear-gradient(145deg, #380226 0%, #150010 100%);
      border: 2px solid #ff529a;
      border-radius: 36px;
      padding: 40px 32px;
      max-width: 540px;
      width: 94%;
      text-align: center;
      box-shadow: 0 0 70px rgba(255, 20, 147, 0.7);
      transform: scale(0.7);
      transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .modal-overlay.active .modal-card {
      transform: scale(1);
    }

    .big-heart-icon {
      font-size: 4rem;
      margin-bottom: 12px;
      animation: heartBeat 1.2s infinite;
      display: inline-block;
    }

    /* Keyframes */
    @keyframes floatCard {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-10px); }
    }

    @keyframes pulseGlow {
      0% { box-shadow: 0 0 15px rgba(255, 20, 147, 0.6); }
      50% { box-shadow: 0 0 35px rgba(255, 20, 147, 1), 0 0 45px rgba(255, 105, 180, 0.8); }
      100% { box-shadow: 0 0 15px rgba(255, 20, 147, 0.6); }
    }

    @keyframes heartBeat {
      0% { transform: scale(1); }
      14% { transform: scale(1.25); }
      28% { transform: scale(1); }
      42% { transform: scale(1.25); }
      70% { transform: scale(1); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Touch instruction text */
    .touch-hint {
      font-size: 0.8rem;
      color: rgba(255, 182, 193, 0.7);
      margin-top: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
  </style>
</head>
<body>

  <!-- WebGL Background Canvas -->
  <div id="canvas-container"></div>

  <!-- Main UI Layer -->
  <div class="ui-layer">
    
    <!-- Top Header Bar -->
    <div class="top-controls">
      <div class="badge-tag">
        ✨ ចូលរួមបង្កើតក្ដីស្រឡាញ់ដ៏ផ្អែមល្ហែម ✨
      </div>
      <button class="icon-btn" id="musicBtn" onclick="toggleMusic()" title="Play/Mute Music">
        <i class="fas fa-music" id="musicIcon"></i>
      </button>
    </div>

    <!-- Main Love Proposal Letter Card -->
    <div class="love-card" id="mainCard">
      <h1 class="khmer-title">បងស្រឡាញ់អូនខ្លាំងណាស់! 💕</h1>
      <div class="english-title">You Are My Entire World</div>
      
      <p class="love-text">
        តាំងពីថ្ងៃដែលអូនបានចូលមកក្នុងជីវិតបងមក គ្រប់វិនាទីទាំងអស់ប្រែជាមានន័យ និងស្អាតបំព្រង។ 
        អូនជាពន្លឺព្រះអាទិត្យនាពេលព្រឹក ជាភាពត្រជាក់ត្រជុំនាពេលយប់ និងជាម្ចាស់បេះដូងតែមួយគត់របស់បង...
      </p>

      <div class="highlight-quote">
        "ក្នុងចំណោមមនុស្សរាប់លាននាក់នៅលើពិភពលោក បេះដូងរបស់បងជ្រើសរើស និងស្រឡាញ់តែអូនម្នាក់គត់!"
      </div>

      <div class="question-prompt">
        តើអូនព្រមធ្វើជាម្ចាស់បេះដូងរបស់បងរហូតទៅទេ? 💖
      </div>

      <div class="touch-hint">
        <i class="fas fa-hand-pointer"></i> ចុចលើបេះដូងតូចៗជុំវិញ ដើម្បីអានសាររ៉ូមែនទិក
      </div>
    </div>

    <!-- Interactive Buttons -->
    <div class="buttons-wrapper" id="btnGroup">
      <button class="btn btn-yes" id="yesBtn" onclick="acceptProposal()">
        <i class="fas fa-heart"></i> ព្រម (Yes 💕)
      </button>
      <button class="btn btn-no" id="noBtn" onmouseover="fleeNoButton()" onclick="fleeNoButton()">
        <i class="fas fa-heart-broken"></i> មិនព្រម (No 💔)
      </button>
    </div>

  </div>

  <!-- Interactive Toast Quote Popup -->
  <div class="quote-toast" id="quoteToast">
    ✨ <span id="toastMessage">អូនជាក្តីស្រមៃដ៏ស្រស់ស្អាតបំផុតរបស់បង!</span>
  </div>

  <!-- Grand Victory Celebration Modal -->
  <div class="modal-overlay" id="successModal">
    <div class="modal-card">
      <div class="big-heart-icon">🥰💖</div>
      <h2 style="font-family: 'Moul', cursive; color: #ff4d94; margin-bottom: 15px; font-size: 2rem;">
        អរគុណណាស់អូនសំឡាញ់! 🎉
      </h2>
      <p style="font-size: 1.15rem; line-height: 1.8; color: #fff0f5; margin-bottom: 20px;">
        បងសន្យាថានឹងមើលថែ ផ្តល់ស្នាមញញឹម និងស្រឡាញ់អូនឲ្យល្អបំផុតជារៀងរហូត! <br>
        <strong style="color: #ff69b4; font-size: 1.25rem;">You Made My Day Complete! 🌹✨</strong>
      </p>
      <button class="btn btn-yes" onclick="closeModal()" style="font-size: 1.1rem; padding: 12px 30px;">
        ស្រឡាញ់បងវិញដូចគ្នា 💖
      </button>
    </div>
  </div>

  <script>
    // --- WEB AUDIO API ROMANTIC SYNTHESIZER ---
    let audioCtx = null;
    let isPlayingMusic = false;
    let melodyInterval = null;

    function initAudio() {
      if (!audioCtx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContext();
      }
    }

    function playNote(freq, duration = 1.2, type = 'sine', vol = 0.1) {
      if (!audioCtx || audioCtx.state === 'suspended') return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

      gain.gain.setValueAtTime(vol, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    }

    function startRomanticMelody() {
      initAudio();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      isPlayingMusic = true;
      document.getElementById('musicIcon').className = 'fas fa-volume-up';

      const notes = [
        261.63, 329.63, 392.00, 523.25, // C4, E4, G4, C5
        349.23, 440.00, 523.25, 698.46, // F4, A4, C5, F5
        392.00, 493.88, 587.33, 783.99, // G4, B4, D5, G5
        329.63, 392.00, 493.88, 659.25  // E4, G4, B4, E5
      ];

      let idx = 0;
      melodyInterval = setInterval(() => {
        if (!isPlayingMusic) return;
        playNote(notes[idx], 1.6, 'sine', 0.08);
        if (idx % 2 === 0) {
          playNote(notes[(idx + 2) % notes.length] / 2, 2.2, 'triangle', 0.04);
        }
        idx = (idx + 1) % notes.length;
      }, 450);
    }

    function stopRomanticMelody() {
      isPlayingMusic = false;
      if (melodyInterval) clearInterval(melodyInterval);
      document.getElementById('musicIcon').className = 'fas fa-music';
    }

    function toggleMusic() {
      if (isPlayingMusic) {
        stopRomanticMelody();
      } else {
        startRomanticMelody();
      }
    }

    function playCelebrationFanfare() {
      initAudio();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      
      const fanfareNotes = [523.25, 659.25, 783.99, 1046.50, 1318.51, 1567.98];
      fanfareNotes.forEach((freq, idx) => {
        setTimeout(() => {
          playNote(freq, 1.2, 'triangle', 0.15);
        }, idx * 120);
      });
    }

    // --- THREE.JS 3D SCENE & GALAXY SETUP ---
    const container = document.getElementById('canvas-container');
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x09010f, 0.02);

    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 13;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Dynamic Lights
    const ambientLight = new THREE.AmbientLight(0xffb6c1, 0.9);
    scene.add(ambientLight);

    const pointLight1 = new THREE.PointLight(0xff1493, 2.8, 60);
    pointLight1.position.set(10, 10, 10);
    scene.add(pointLight1);

    const pointLight2 = new THREE.PointLight(0x8a2be2, 2.2, 60);
    pointLight2.position.set(-10, -10, 8);
    scene.add(pointLight2);

    // --- 3D HEART GEOMETRY BUILDER ---
    function generateHeartShape() {
      const shape = new THREE.Shape();
      const x = 0, y = 0;
      shape.moveTo(x + 0.5, y + 0.5);
      shape.bezierCurveTo(x + 0.5, y + 0.5, x + 0.4, y, x, y);
      shape.bezierCurveTo(x - 0.6, y, x - 0.6, y + 0.7, x - 0.6, y + 0.7);
      shape.bezierCurveTo(x - 0.6, y + 1.1, x - 0.3, y + 1.54, x + 0.5, y + 1.9);
      shape.bezierCurveTo(x + 1.3, y + 1.54, x + 1.6, y + 1.1, x + 1.6, y + 0.7);
      shape.bezierCurveTo(x + 1.6, y + 0.7, x + 1.6, y, x + 1.0, y);
      shape.bezierCurveTo(x + 0.7, y, x + 0.5, y + 0.5, x + 0.5, y + 0.5);
      return shape;
    }

    const extrudeSettings = {
      depth: 0.45,
      bevelEnabled: true,
      bevelSegments: 6,
      steps: 2,
      bevelSize: 0.18,
      bevelThickness: 0.18
    };

    const heartGeometry = new THREE.ExtrudeGeometry(generateHeartShape(), extrudeSettings);
    heartGeometry.center();

    // Glossy Main Heart Material
    const mainHeartMat = new THREE.MeshPhongMaterial({
      color: 0xff0055,
      emissive: 0x4a0018,
      specular: 0xffb6c1,
      shininess: 100,
      side: THREE.DoubleSide
    });

    const mainHeart = new THREE.Mesh(heartGeometry, mainHeartMat);
    mainHeart.scale.set(2.0, 2.0, 2.0);
    mainHeart.rotation.x = Math.PI;
    scene.add(mainHeart);

    // Orbiting Mini 3D Hearts (Clickable for Quotes)
    const miniHeartsGroup = new THREE.Group();
    const miniHeartsList = [];
    const miniHeartCount = 38;

    const romanticQuotesKhmer = [
      "អូនជាពន្លឺក្នុងបេះដូងបង 💖",
      "ស្នាមញញឹមអូនជាថ្នាំទិព្វរបស់បង 🌸",
      "បងស្រឡាញ់អូនរហូតទៅ ✨",
      "អូនជាពិភពលោកទាំងមូលរបស់បង 🌍💕",
      "គ្មានអ្វីអាត់ប្រៀបនឹងអូនបានឡើយ 🥰",
      "បេះដូងបងមានតែអូនម្នាក់គត់ 🔐💖"
    ];

    for (let i = 0; i < miniHeartCount; i++) {
      const miniMat = new THREE.MeshPhongMaterial({
        color: Math.random() > 0.4 ? 0xff1493 : 0xff69b4,
        emissive: 0x2b0010,
        shininess: 80
      });

      const mesh = new THREE.Mesh(heartGeometry, miniMat);
      const scale = 0.18 + Math.random() * 0.28;
      mesh.scale.set(scale, scale, scale);
      mesh.rotation.x = Math.PI;

      const angle = Math.random() * Math.PI * 2;
      const radius = 4.5 + Math.random() * 7.5;
      const y = (Math.random() - 0.5) * 10;

      mesh.position.set(Math.cos(angle) * radius, y, Math.sin(angle) * radius);

      const heartData = {
        mesh,
        angle,
        radius,
        speed: 0.006 + Math.random() * 0.012,
        rotSpeed: (Math.random() - 0.5) * 0.03,
        quote: romanticQuotesKhmer[Math.floor(Math.random() * romanticQuotesKhmer.length)]
      };

      mesh.userData = heartData;
      miniHeartsList.push(heartData);
      miniHeartsGroup.add(mesh);
    }
    scene.add(miniHeartsGroup);

    // Galaxy Particle Stars
    const particleCount = 450;
    const particleGeo = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount * 3; i += 3) {
      positions[i] = (Math.random() - 0.5) * 35;
      positions[i + 1] = (Math.random() - 0.5) * 35;
      positions[i + 2] = (Math.random() - 0.5) * 35;
    }

    particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const particleMat = new THREE.PointsMaterial({
      color: 0xffc0cb,
      size: 0.14,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending
    });

    const starParticles = new THREE.Points(particleGeo, particleMat);
    scene.add(starParticles);

    // --- RAYCASTING FOR CLICKING FLOATING HEARTS ---
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    window.addEventListener('click', (e) => {
      // Avoid clicking when interacting with buttons
      if (e.target.closest('.ui-layer') && !e.target.classList.contains('ui-layer')) return;

      mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(miniHeartsGroup.children);

      if (intersects.length > 0) {
        const clickedHeart = intersects[0].object;
        showToastQuote(clickedHeart.userData.quote);

        // Little bounce animation
        clickedHeart.scale.multiplyScalar(1.4);
        setTimeout(() => {
          clickedHeart.scale.divideScalar(1.4);
        }, 300);
      }
    });

    function showToastQuote(msg) {
      const toast = document.getElementById('quoteToast');
      document.getElementById('toastMessage').innerText = msg;
      toast.classList.add('active');
      setTimeout(() => {
        toast.classList.remove('active');
      }, 3000);
    }

    // Interactive Dragging
    let isDragging = false;
    let prevMouse = { x: 0, y: 0 };

    window.addEventListener('pointerdown', (e) => {
      isDragging = true;
      prevMouse = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - prevMouse.x;
      const deltaY = e.clientY - prevMouse.y;

      mainHeart.rotation.y += deltaX * 0.008;
      mainHeart.rotation.z += deltaY * 0.008;

      prevMouse = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('pointerup', () => { isDragging = false; });

    // --- ANIMATION LOOP ---
    const clock = new THREE.Clock();
    let isAccepted = false;

    function animateScene() {
      requestAnimationFrame(animateScene);
      const elapsed = clock.getElapsedTime();

      // Main Heart Breathing & Rotation
      if (!isDragging && !isAccepted) {
        mainHeart.rotation.y += 0.008;
        const scale = 2.0 + Math.sin(elapsed * 2.8) * 0.12;
        mainHeart.scale.set(scale, scale, scale);
      } else if (isAccepted) {
        mainHeart.rotation.y += 0.04;
        mainHeart.rotation.z += 0.015;
      }

      // Orbiting Mini Hearts Animation
      miniHeartsList.forEach(item => {
        item.angle += item.speed;
        item.mesh.position.x = Math.cos(item.angle) * item.radius;
        item.mesh.position.z = Math.sin(item.angle) * item.radius;
        item.mesh.position.y += Math.sin(elapsed + item.angle) * 0.006;
        item.mesh.rotation.y += item.rotSpeed;
      });

      starParticles.rotation.y = elapsed * 0.025;
      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // --- RUNAWAY "NO" BUTTON MECHANICS ---
    const noBtn = document.getElementById('noBtn');
    const yesBtn = document.getElementById('yesBtn');
    let yesScale = 1;

    function fleeNoButton() {
      const maxX = window.innerWidth - noBtn.offsetWidth - 30;
      const maxY = window.innerHeight - noBtn.offsetHeight - 30;

      const randomX = Math.max(20, Math.floor(Math.random() * maxX));
      const randomY = Math.max(20, Math.floor(Math.random() * maxY));

      noBtn.style.position = 'fixed';
      noBtn.style.left = `${randomX}px`;
      noBtn.style.top = `${randomY}px`;

      // Grow YES button
      yesScale += 0.15;
      if (yesScale < 2.2) {
        yesBtn.style.transform = `scale(${yesScale})`;
      }
    }

    // --- GRAND VICTORY CELEBRATION ---
    function acceptProposal() {
      isAccepted = true;
      playCelebrationFanfare();

      if (!isPlayingMusic) {
        startRomanticMelody();
      }

      // Hide main letter card
      const card = document.getElementById('mainCard');
      const btnGroup = document.getElementById('btnGroup');

      card.style.opacity = '0';
      card.style.transform = 'scale(0.8)';
      card.style.pointerEvents = 'none';

      btnGroup.style.opacity = '0';
      btnGroup.style.pointerEvents = 'none';

      // Scale Up 3D Heart in scene
      let heartScale = 2.0;
      const scaleInterval = setInterval(() => {
        heartScale += 0.08;
        mainHeart.scale.set(heartScale, heartScale, heartScale);
        if (heartScale >= 4.8) clearInterval(scaleInterval);
      }, 20);

      // Trigger Confetti & Heart Fireworks
      const end = Date.now() + 4 * 1000;
      const colors = ['#ff1493', '#ff69b4', '#ffffff', '#e60073'];

      (function frame() {
        confetti({
          particleCount: 6,
          angle: 60,
          spread: 60,
          origin: { x: 0 },
          colors
        });
        confetti({
          particleCount: 6,
          angle: 120,
          spread: 60,
          origin: { x: 1 },
          colors
        });

        if (Date.now() < end) {
          requestAnimationFrame(frame);
        }
      })();

      // Show Modal
      setTimeout(() => {
        document.getElementById('successModal').classList.add('active');
      }, 800);
    }

    function closeModal() {
      document.getElementById('successModal').classList.remove('active');
    }

    // Start 3D Loop on Window Load
    window.onload = function() {
      animateScene();
    };
  </script>
</body>
</html>
